      "stage": "stages/world-01.html",
      "writes": [
        "aim",
        "boxHidden"
      ],
      "script": {
        "file": "map.js",
        "functions": [
          "mapCamera"
        ],
        "starter": "// The map camera: lesson 1, \"Use it on a new case\".\n// A plain script with one function and no import or export lines. It runs with the pure functions of your\n// world.html in scope, so it may call perspective, viewMatrix, mul4 and the rest.\nfunction mapCamera(m, cx, cz, half, aspect) {\n  throw new Error('mapCamera: not written yet');\n}\n"
      },
      "brief": {
        "interface": [
          {
            "name": "aim",
            "pattern": "\\baim\\b",
            "example": "aim(eye, target)"
          },
          {
            "name": "boxHidden",
            "pattern": "\\bboxHidden\\b",
            "example": "boxHidden(pl, x0, y0, z0, x1, y1, z1)"
          },
          {
            "name": "yaw and pitch, what aim returns",
            "pattern": "\\byaw\\b[\\s\\S]*\\bpitch\\b|\\bpitch\\b[\\s\\S]*\\byaw\\b",
            "example": "aim returns [yaw, pitch]"
          },
          {
            "name": "the units: radians and metres",
            "pattern": "\\brad(ian)?s?\\b[\\s\\S]*(\\bmet(re|er)s?\\b|\\bm\\b)|(\\bmet(re|er)s?\\b|\\bm\\b)[\\s\\S]*\\brad(ian)?s?\\b",
            "example": "angles in radians, positions in metres"
          }
        ],
        "constraints": [
          {
            "name": "one file",
            "pattern": "\\b(one|single|1)\\b[^.]{0,40}\\bfile\\b|self-contained|\\bfile\\b[^.]{0,30}\\b(by itself|alone|on its own)\\b",
            "example": "one HTML file"
          },
          {
            "name": "no libraries",
            "pattern": "\\b(no|not|without|never|zero|free of)\\b[^.]{0,60}\\b(librar(y|ies)|dependenc(y|ies)|packages?|frameworks?)\\b|\\bvanilla\\b|\\bplain JavaScript\\b",
            "example": "no libraries"
          },
          {
            "name": "no images or other assets",
            "pattern": "\\b(no|not|without|never|zero)\\b[^.]{0,80}\\b(assets?|images?|pictures?|models|textures? files?|media files?|sound files?)\\b",
            "example": "no images or other assets"
          },
          {
            "name": "the determinism rule",
            "pattern": "determinis|Math\\.random|\\bsame (seed|numbers?|input)\\b[^.]{0,80}\\bsame\\b|\\bexact(ly)? (operations|the same)\\b",
            "example": "the determinism rule: no Math.random, and the same seed gives the same island"
          }
        ],
        "check": {
          "name": "the check command",
          "pattern": "node lab\\.mjs check \\S+ 1\\b"
        },
        "notes": [
          {
            "name": "the goal, as something on screen",
            "pattern": "^#+\\s*goal"
          },
          {
            "name": "references, described by their properties",
            "pattern": "^#+\\s*references?"
          },
          {
            "name": "what to hand back",
            "pattern": "^#+\\s*(hand ?back|report|what to hand back)"
          }
        ]
      },
      "file": "world.html"
