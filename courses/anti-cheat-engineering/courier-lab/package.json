    "test:mutants": "node tests/mutants.mjs",
    "ci": "npm test && npm run test:mutants",
    "replay": "node lab/replay.mjs",
    "lab:prepare": "node lab/prepare.mjs",
    "lab:check": "node lab/check.mjs",
    "test:browser": "node tests/browser.mjs",
    "order:prepare": "node lab/order/prepare.mjs",
    "order:check": "node lab/order/check.mjs",
    "start:verified": "node verified-server.mjs",
    "runtime:approve": "node tools/approve-runtime.mjs",
    "core:prepare": "node lab/core/prepare.mjs",
    "core:check": "node lab/core/check.mjs",
    "trace:sample": "node tools/capture-window.mjs",
    "window:replay": "node tools/replay-window.mjs",
    "runtime:copy": "node tools/copy-runtime.mjs",
    "evidence:build": "node tools/build-evidence-examples.mjs",
    "core:recover": "node lab/core/recover.mjs",
    "evaluation:plan": "node tools/analysis-cli.mjs plan",
    "evaluation:run": "node tools/analysis-cli.mjs run",
