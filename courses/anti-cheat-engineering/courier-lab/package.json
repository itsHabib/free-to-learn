    "evaluation:explore": "node tools/analysis-cli.mjs explore",
    "test:completion-browser": "node tests/completion-browser.mjs",
    "test:learning": "node --test tests/learning-runtime.test.mjs",
    "test:learning-browser": "node tests/learning-browser.mjs",
    "lab:practice": "node lab/check.mjs --fresh",
    "order:practice": "node lab/order/check.mjs --fresh",
    "core:practice": "node lab/core/check.mjs --fresh",
    "test:accessibility": "node tests/accessibility-browser.mjs",
