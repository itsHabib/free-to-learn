            "pattern": "\\b(only|just)\\b[^.]{0,60}\\b(functions?|regions?|methods?)\\b|\\b(do not|don't|never|must not)\\b[^.]{0,40}\\b(change|edit|touch|modify|rename)\\b[^.]{0,60}\\b(other|supplied|signatures?|anything else|files?)\\b",
            "example": "change only these functions; keep their signatures and leave the supplied code alone"
          },
          {
            "name": "the shading budget",
            "pattern": "\\bbudget\\b|\\bvisible warps\\b",
            "example": "warps launched within the shading budget"
          },
          {
            "name": "colours come from shadeWarp",
            "pattern": "\\bshadeWarp\\b",
            "example": "every visible colour comes from shadeWarp"
          }
        ],
        "check": {
          "name": "the check command",
          "pattern": "node lab\\.mjs check 9\\b"
        },
        "notes": [
          {
            "name": "the goal",
            "pattern": "^#+\\s*goal"
          },
          {
            "name": "references, described by what they do",
            "pattern": "^#+\\s*references?"
          },
          {
            "name": "what to hand back",
            "pattern": "^#+\\s*(hand ?back|report|what to hand back)"
          }
        ]
      }
    }
  ]
}
